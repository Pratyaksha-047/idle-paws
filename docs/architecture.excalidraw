  {
   "id": "text67",
   "type": "text",
   "x": 1260,
   "y": 105,
   "width": 364.65000000000003,
   "height": 552.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
